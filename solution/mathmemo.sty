\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mathmemo}[2026/05/18 v0.1 Notes and short reports]

%%%%%%%%%% Core packages %%%%%%%%%%
\RequirePackage{amsmath,amssymb,amsthm,euscript,mathrsfs,bm}
\RequirePackage{dsfont}            % for \mathds
\RequirePackage[shortlabels]{enumitem}
\RequirePackage{tikz-cd}
\RequirePackage{setspace}

%%%%%%%%%% Fonts %%%%%%%%%%
% Palatino-based: blander than ebgaramond, clearly distinct from your paper style.
\RequirePackage{newpxtext}
\RequirePackage{newpxmath}

\setstretch{1.15}

%%%%%%%%%% Page geometry %%%%%%%%%%
\RequirePackage[margin=1in,headheight=15pt,headsep=12pt]{geometry}

%%%%%%%%%% Header / footer %%%%%%%%%%
\RequirePackage{fancyhdr}

% A short running title and date can be set by the document.
\providecommand{\memotitle}{}
\providecommand{\memodate}{\today}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\itshape\memodate}
\fancyhead[C]{\small\scshape\memotitle}
\fancyhead[R]{\small\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}

% Plain pagestyle (used by \maketitle and section openings):
% keep the same running header as \fancy so the title page shows it too.
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyhead[L]{\small\itshape\memodate}%
  \fancyhead[C]{\small\scshape\memotitle}%
  \fancyhead[R]{\small\thepage}%
  \renewcommand{\headrulewidth}{0.4pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

% amsart's \maketitle internally issues \thispagestyle{empty}, which blanks
% the title page header. Patch \maketitle so that after it runs we restore
% the fancy header on the title page.
\let\mathmemo@oldmaketitle\maketitle
\renewcommand{\maketitle}{%
  \mathmemo@oldmaketitle%
  \thispagestyle{fancy}%
}

%%%%%%%%%% Hyperref (load late) %%%%%%%%%%
\RequirePackage[colorlinks=true,linkcolor=black,citecolor=black,urlcolor=blue!50!black]{hyperref}

